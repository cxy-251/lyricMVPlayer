      "text": "♪"
    },
    {
      "startMs": 12770,
      "endMs": 15310,
      "text": "I bottled up my feelings"
    },
    {
      "startMs": 17380,
      "endMs": 20800,
      "text": "Into a special brew"
    },
    {
      "startMs": 21230,
      "endMs": 24260,
      "text": "I poured my heart into a potion"
    },
    {
      "startMs": 26330,
      "endMs": 30290,
      "text": "Worthy of you"
    },
    {
      "startMs": 30290,
      "endMs": 34490,
      "text": "I had the best of intentions"
    },
    {
      "startMs": 34670,
      "endMs": 38870,
      "text": "I just want someone to love"
    },
    {
      "startMs": 39120,
      "endMs": 42580,
      "text": "I thought you'd be in my arms by now"
    },
    {
      "startMs": 42580,
      "endMs": 45820,
      "text": "But you're not"
    },
    {
      "startMs": 45820,
      "endMs": 49570,
      "text": "Why doesn't my magic work on you"
    },
    {
      "startMs": 49570,
      "endMs": 53770,
      "text": "The spell should have come true"
    },
    {
      "startMs": 54800,
      "endMs": 58670,
      "text": "You got me under the fool moon"
    },
    {
      "startMs": 58670,
      "endMs": 62870,
      "text": "I'm such a fool for you"
    },
    {
      "startMs": 64440,
      "endMs": 66670,
      "text": "I'm asking the stars"
    },
    {
      "startMs": 66670,
      "endMs": 69000,
      "text": "Why haven't they brought you into my arms"
    },
    {
      "startMs": 71070,
      "endMs": 73950,
      "text": "Why am I still lonely when it gets dark"
    },
    {
      "startMs": 76020,
      "endMs": 83020,
      "text": "I'm a fool for you under the fool moon"
    },
    {
      "startMs": 84590,
      "endMs": 88240,
      "text": "See I barely remember"
    },
