  "poetryFrame": {
    "nickname": "@xcai43323",
    "topLabel": "@xcai43323 · AUDIO DIARY",
    "leftVertical": "THE LABOR OF HEARTFELT BREWING AGAINST THE VOID'S CALL",
    "rightVertical": "A QUIET LONELINESS BENEATH THE GIANT MOON'S GAZE",
    "bottomLine": "YEARNING ECHOES IN THE SILVER TIDE",
    "sonnetLines": [
      "The heart is a vessel,",
      "Filled with careful intent;",
      "A fragile magic potion,",
      "On promises spent.",
      "You remain out of reach,",
      "Beyond the soft glow;",
      "And I watch the pale moon,",
      "Where true feelings go.",
      "I build up my hopes high,",
      "Then they drift and descend;",
      "Just a fool for your grace,",
      "A cycle without end.",
      "The stars offer no reply,",
      "Only silent expanse."
    ]
  },
