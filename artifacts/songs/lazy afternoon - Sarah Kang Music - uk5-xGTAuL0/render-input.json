    {
      "startMs": 10650,
      "endMs": 16150,
      "text": "I could travel to Paris and see the city lights"
    },
    {
      "startMs": 16150,
      "endMs": 21650,
      "text": "Ride a boat in Venice, what a beautiful sight"
    },
    {
      "startMs": 21650,
      "endMs": 27250,
      "text": "I could journey afar to an ocean so blue"
    },
    {
      "startMs": 27250,
      "endMs": 32580,
      "text": "But nothing is as beautiful as you"
    },
    {
      "startMs": 32580,
      "endMs": 38320,
      "text": "I could climb up a hill and watch the sunrise"
    },
    {
      "startMs": 38320,
      "endMs": 43620,
      "text": "Wander until the stars fill up the skies"
    },
    {
      "startMs": 43620,
      "endMs": 49130,
      "text": "But none of that matters if you aren't there, too"
    },
    {
      "startMs": 49130,
      "endMs": 54780,
      "text": "I wanna be next to you"
    },
    {
      "startMs": 54780,
      "endMs": 60130,
      "text": "If you would like to spend some time"
    },
    {
      "startMs": 60130,
      "endMs": 65400,
      "text": "I'd like to spend it with you"
    },
    {
      "startMs": 65400,
      "endMs": 68420,
      "text": "A glass of red wine"
    },
    {
      "startMs": 68420,
      "endMs": 70730,
      "text": "Just you and I"
    },
    {
      "startMs": 70730,
      "endMs": 76490,
      "text": "On a lazy afternoon"
    },
    {
      "startMs": 76490,
      "endMs": 81670,
      "text": "They say that someday the romance will fade"
