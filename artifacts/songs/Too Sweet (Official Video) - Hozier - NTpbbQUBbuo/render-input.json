      "text": "♪"
    },
    {
      "startMs": 19280,
      "endMs": 22420,
      "text": "It can't be said I'm an early bird"
    },
    {
      "startMs": 23280,
      "endMs": 26380,
      "text": "It's ten o'clock before I say a word"
    },
    {
      "startMs": 27400,
      "endMs": 29800,
      "text": "Baby, I can never tell"
    },
    {
      "startMs": 29800,
      "endMs": 31760,
      "text": "How do you sleep so well?"
    },
    {
      "startMs": 31760,
      "endMs": 34000,
      "text": "You keep telling me to live right"
    },
    {
      "startMs": 34780,
      "endMs": 37860,
      "text": "To go to bed before the daylight"
    },
    {
      "startMs": 39300,
      "endMs": 42240,
      "text": "But then you wake up for the sunrise"
    },
    {
      "startMs": 43440,
      "endMs": 48120,
      "text": "You know you don't gotta pretend, baby, now and then"
    },
    {
      "startMs": 48120,
      "endMs": 52180,
      "text": "Don't you just wanna wake up, dark as a lake?"
    },
    {
      "startMs": 52180,
      "endMs": 56420,
      "text": "Smelling like a bonfire, lost in a haze?"
    },
    {
      "startMs": 56420,
      "endMs": 60240,
      "text": "If you're drunk on life, babe, I think it's great"
    },
    {
      "startMs": 60240,
      "endMs": 62340,
      "text": "But while in this world"
    },
    {
      "startMs": 62340,
      "endMs": 66120,
      "text": "I think I'll take my whiskey neat"
    },
    {
      "startMs": 66680,
      "endMs": 71750,
      "text": "My coffee black and my bed at three"
    },
    {
      "startMs": 71750,
      "endMs": 75701,
      "text": "You're too sweet for me"
    },
