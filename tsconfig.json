{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@modules/*": [
        "./modules/*/src",
        "./modules/*/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "modules",
    "remotion.config.ts"
  ]
}
