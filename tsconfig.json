{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@modules/*": [
        "./modules/*/src",
        "./modules/*/src/index.ts"
      ],
      "@lyric-mv/visual-effects": ["./modules/visual-effects/src/index.ts"],
      "@lyric-mv/visual-effects/*": ["./modules/visual-effects/src/*"],
      "@paper-to-video/atomic-ui": ["./modules/paper-video/packages/atomic-ui/src/index.tsx"],
      "@paper-to-video/content-pipeline": ["./modules/paper-video/packages/content-pipeline/src/index.ts"],
      "@paper-to-video/shared-types": ["./modules/paper-video/packages/shared-types/src/index.ts"],
      "@paper-to-video/timeline-engine": ["./modules/paper-video/packages/timeline-engine/src/index.tsx"]
    }
  },
  "include": [
    "src",
    "modules",
    "remotion.config.ts"
  ]
}
