# ==============================================================================
# Environment & IDE
# ==============================================================================
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
*.log
__pycache__/
*.pyc

.venv/

# ==============================================================================
# Node & Build
# ==============================================================================
node_modules/
dist/
public-web/
.turbo/
.cache/
coverage/

# ==============================================================================
# Modules & External
# ==============================================================================
# Paper video source is integrated under modules; generated outputs stay isolated.
modules/paper-video/apps/editor-web/dist/
modules/paper-video/output/
modules/paper-video/release/
modules/paper-video/build/

# ==============================================================================
# Artifacts (Media, State, Outputs)
# ==============================================================================
# By default, ignore all artifacts
artifacts/*

# Whitelist common config/state files
!artifacts/common/
artifacts/common/*
!artifacts/common/library-state.json
!artifacts/common/production-queue.csv
!artifacts/common/recent-downloads.json

# Never commit local secrets or machine-specific runtime files
artifacts/common/youtube-cookies.txt
artifacts/common/yt-dlp-archive.txt
artifacts/common/playlist-pipeline.json
artifacts/common/*.pipeline.json
artifacts/common/models/

# The complete song library is local production data.
# Ignore songs and songsout directories.
# (Note: previously tracked demo files will remain tracked in git).
artifacts/songs/
artifacts/songsout/

# Keep paper-video artifacts out, except the lightweight Web demo manifests.
!artifacts/paper-video/
artifacts/paper-video/*
!artifacts/paper-video/.gitkeep
!artifacts/paper-video/output/
artifacts/paper-video/output/*
!artifacts/paper-video/output/runs/
artifacts/paper-video/output/runs/*
!artifacts/paper-video/output/runs/*/
artifacts/paper-video/output/runs/*/*
!artifacts/paper-video/output/runs/*/*/
artifacts/paper-video/output/runs/*/*/*
!artifacts/paper-video/output/runs/*/*/manifests/
artifacts/paper-video/output/runs/*/*/manifests/*
!artifacts/paper-video/output/runs/demo-paper-001/demo-default/manifests/render-manifest.json
