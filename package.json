{
  "name": "lyric-mv-player",
  "version": "0.1.0",
  "private": true,
  "description": "Automated lyric video production pipeline using Remotion, TypeScript, and generated visuals.",
  "scripts": {
    "dev": "node tools/dev-with-sync.mjs",
    "dev:web": "node tools/build-web-public.mjs && vite --host 127.0.0.1 --port 3212",
    "build:web": "node tools/build-web-public.mjs --demo && vite build",
    "build:web:local": "node tools/build-web-public.mjs && vite build",
    "clean:media": "node tools/clean-media.mjs",
    "refresh:cookies": "conda run -n kwai python backend/audio-download/refresh_youtube_cookies.py /Users/cxy251/Code/04AIMedia/lyricMVPlayer",
    "prepare:playlist": "conda run -n kwai python backend/playlist-pipeline/playlist_pipeline.py",
    "generate:background:current": "conda run -n kwai python backend/background-generation/run_background_generation.py current .",
    "generate:backgrounds": "conda run -n kwai python backend/background-generation/run_background_generation.py queue .",
    "regenerate:lyrics-llm-workflow-text": "conda run -n kwai python backend/background-generation/run_background_generation.py lyrics-llm-workflow-text .",
    "apply:manual-lyrics": "node tools/apply-manual-lyrics.mjs",
    "render:queue": "node tools/render-queued-videos.mjs",
    "use:song": "node tools/select-song-for-preview.mjs",
    "render": "node tools/render-current-song.mjs",
    "typecheck": "tsc --noEmit",
    "test:visual-effects": "node --import tsx tools/validate-visual-effects.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@react-three/rapier": "^2.2.0",
    "@remotion/player": "^4.0.461",
    "@remotion/tailwind-v4": "^4.0.461",
    "@tailwindcss/postcss": "^4.3.0",
    "clsx": "^2.1.1",
    "leva": "^0.10.1",
    "lucide-react": "^1.16.0",
    "postprocessing": "^6.39.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^8.0.1",
    "remotion": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.461",
    "@tailwindcss/cli": "4.3.0",
    "@tailwindcss/vite": "^4.3.1",
    "@types/node": "^24.9.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^5.0.4",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "vite": "^7.1.7",
    "vite-plugin-glsl": "^1.6.0"
  }
}
