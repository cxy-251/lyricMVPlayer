{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "paths": {
      "@paper-to-video/shared-types": ["packages/shared-types/src/index.ts"],
      "@paper-to-video/content-pipeline": ["packages/content-pipeline/src/index.ts"],
      "@paper-to-video/atomic-ui": ["packages/atomic-ui/src/index.tsx"],
      "@paper-to-video/timeline-engine": ["packages/timeline-engine/src/index.tsx"]
    }
  }
}
